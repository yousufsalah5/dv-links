{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dv-links",
  "main": ".open-next/worker.js",

  // nodejs_compat is what lets the MongoDB driver open a TCP/TLS connection
  // to Atlas. With a compatibility date this recent it already includes the
  // v2 behaviour, so the older nodejs_compat_v2 flag is not needed.
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
