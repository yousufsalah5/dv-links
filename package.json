{
  "name": "dv-links",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "links": "wrangler d1 execute dv-links-db --local --command=\"SELECT sort_order, featured, title, url FROM links ORDER BY sort_order\"",
    "db:migrate": "wrangler d1 migrations apply dv-links-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dv-links-db --remote",
    "db:seed": "wrangler d1 execute dv-links-db --local --file=db/seed.sql",
    "db:seed:remote": "wrangler d1 execute dv-links-db --remote --file=db/seed.sql",
    "links:remote": "wrangler d1 execute dv-links-db --remote --command=\"SELECT sort_order, featured, title, url FROM links ORDER BY sort_order\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.125.0"
  }
}
